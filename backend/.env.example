# Porta da API
PORT=3333

# Ambiente: development | production
NODE_ENV=development

# Segredo usado para assinar os tokens JWT.
# OBRIGATÓRIO em produção. Gere um valor aleatório longo.
JWT_SECRET=

# Tempo de expiração do token (ex.: 7d, 12h, 30m)
JWT_EXPIRES_IN=7d

# Custo do hash bcrypt
BCRYPT_ROUNDS=10

# Origens permitidas no CORS. Use "*" para liberar todas (apenas em dev),
# ou uma lista separada por vírgula: https://app.exemplo.com,https://admin.exemplo.com
CORS_ORIGIN=*
